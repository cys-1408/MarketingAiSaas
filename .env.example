# Marketing Intelligence and Campaign Copilot SaaS — example environment
#
# Every variable is optional except the ones marked REQUIRED (in production).
# Copy to `.env` and adjust. Setting names must match `app/core/config.py`
# exactly (the `APP_` prefix below corresponds to the Settings fields).

# --- General ---------------------------------------------------------------
# environment: development | test | production
APP_ENVIRONMENT=development
# API route prefix served by FastAPI (health also answers at /health and /ready)
APP_API_PREFIX=/api/v1
APP_APP_NAME="Marketing Intelligence and Campaign Copilot"
APP_APP_VERSION=0.1.0

# --- Persistence (REQUIRED in production) -----------------------------------
# Local development works with SQLite with no extra services:
#   sqlite:///./data/marketingai.db
# For production/docker-compose, point at PostgreSQL:
#   postgresql+psycopg://marketingai:marketingai@localhost:5432/marketingai
APP_DATABASE_URL=sqlite:///./data/marketingai.db
APP_DB_ECHO=false
# Directory used for uploaded source bytes (object-storage emulation)
APP_OBJECT_STORAGE_DIR=./data/object_storage

# --- Background work --------------------------------------------------------
# The API process drains the ingestion job queue with a worker thread when
# enabled. Tests set APP_INGEST_WORKER_ENABLED=false and drive the pipeline
# synchronously for determinism.
APP_INGEST_WORKER_ENABLED=true

# --- Security (APP_SESSION_SECRET is REQUIRED outside development) ----------
# At least 16 characters; the default below is rejected in non-dev environments.
APP_SESSION_SECRET=change-me-in-nondev-environments
# Session token lifetime in seconds (default 8h).
APP_SESSION_TTL_SECONDS=28800
# Minimum accepted password length.
APP_PASSWORD_MIN_LENGTH=10

# --- CORS -------------------------------------------------------------------
# JSON list for pydantic-settings:
APP_CORS_ORIGINS=["http://localhost:5173"]

# --- Upload limits -----------------------------------------------------------
APP_UPLOAD_MAX_BYTES=26214400
APP_UPLOAD_MAX_ROWS=200000
APP_UPLOAD_MAX_PAGES=2000
APP_UPLOAD_MAX_CELLS=4000000

# --- Conversion attribution ----------------------------------------------------
APP_CONVERSION_ATTRIBUTION_WINDOW_DAYS=7

# --- Model routing -----------------------------------------------------------
# model_mode: mock | ollama
#   mock  – deterministic in-process summarization (tests/CI)
#   ollama – routes inference through the customer's paired local connector
APP_MODEL_MODE=mock
# Hosted fallback is OFF by default and only ever used when ALL of these are
# set AND APP_ALLOW_HOSTED_FALLBACK=true is explicitly opted in. Contact/
# source text still stays out of telemetry keys; hosted mode sends retrieved
# context to the provider, so opt in only with an adequate data agreement.
APP_HOSTED_PROVIDER=
APP_HOSTED_API_KEY=
APP_HOSTED_MODEL=
APP_ALLOW_HOSTED_FALLBACK=false

# --- Provider OAuth (functional only when client id AND secret are set) ------
APP_GOOGLE_ANALYTICS_CLIENT_ID=
APP_GOOGLE_ANALYTICS_CLIENT_SECRET=
APP_GOOGLE_ANALYTICS_SCOPES=https://www.googleapis.com/auth/analytics.readonly
APP_MAILCHIMP_CLIENT_ID=
APP_MAILCHIMP_CLIENT_SECRET=
APP_MAILCHIMP_SCOPES=campaigns.readonly

# --- Rate limits ---------------------------------------------------------------
APP_RATE_LIMIT_PER_MINUTE=120
APP_CHAT_RATE_LIMIT_PER_MINUTE=20

# --- Agent bounds ---------------------------------------------------------------
APP_AGENT_MAX_TOOL_CALLS=6
APP_AGENT_MAX_ITERATIONS=8
APP_AGENT_MODEL_TIMEOUT_SECONDS=60
APP_GRAPH_TRAVERSAL_MAX_DEPTH=3
APP_GRAPH_TRAVERSAL_MAX_NODES=200

# --- Retrieval -------------------------------------------------------------------
APP_EMBEDDING_DIM=256
APP_RETRIEVAL_TOP_K=12
APP_BM25_CANDIDATES=12
APP_VECTOR_CANDIDATES=12
APP_RERANK_CANDIDATES=8

# --- Cache --------------------------------------------------------------------------
APP_CACHE_MAX_PAYLOAD_BYTES=8000

# --- Data ------------------------------------------------------------------------------
APP_SYNTHETIC_DEMO_DIR=./data/synthetic_demo
APP_EVALS_DIR=./evals
